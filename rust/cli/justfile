set shell := ["bash", "-cu"]
set positional-arguments

_default:
    just --list

# Format with nightly's import-grouping support.
fmt:
    @cargo +nightly fmt --all

# Check formatting without changing files.
fmt-check:
    @cargo +nightly fmt --all -- --check

# Type-check every target and feature.
check:
    @cargo check --all-targets --all-features

# Run Clippy and fail on warnings.
lint:
    @cargo clippy --all-targets --all-features -- -D warnings

# Run tests, including documentation tests where applicable.
test:
    @cargo test --all-features

# Build the release binary.
build:
    @cargo build --release

# Run the CLI; forward arguments as separate shell arguments.
run *args:
    @cargo run -- "$@"

# Run all development checks.
verify: fmt-check check lint test
